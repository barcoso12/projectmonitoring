{
  "version": 2,
  "buildCommand": "npm run build-frontend && npx prisma generate --schema=backend/prisma/schema.prisma",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
